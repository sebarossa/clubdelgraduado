---
import Silhouette from "./Silhouette.astro";
import { departamentos } from "../data/campaign.js";
---
<div data-dept-selector>
  <div class="dept-bar" role="tablist">
    {departamentos.map((d, i) => (
      <button
        class:list={["dept-tab", { active: i === 0 }]}
        data-dept-tab={d.id}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        type="button"
      >
        {d.corto}
      </button>
    ))}
  </div>

  {departamentos.map((d, i) => {
    const todos = [...d.titulares, ...d.suplentes];
    return (
      <div class="dept-panel" data-dept-panel={d.id} hidden={i !== 0}>
        <header class="dept-panel__header">
          <h3 class="dept-panel__title">
            <span class="script">Departamento</span>
            {d.nombre}
          </h3>
        </header>

        <div class="photo-grid">
          {todos.map((p) => (
            p.foto
              ? <img class="photo-grid__img" src={p.foto} alt={p.name} loading="lazy" />
              : <div class="photo-grid__placeholder">
                  <div class="photo-grid__placeholder-avatar">
                    <Silhouette tone="violet" className="card__silhouette" />
                  </div>
                  <span class="photo-grid__pending-name">{p.name}</span>
                </div>
          ))}
        </div>
      </div>
    );
  })}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-dept-selector]").forEach((root) => {
    const tabs   = root.querySelectorAll<HTMLButtonElement>("[data-dept-tab]");
    const panels = root.querySelectorAll<HTMLElement>("[data-dept-panel]");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.deptTab;
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle("active", active);
          t.setAttribute("aria-selected", active ? "true" : "false");
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.deptPanel !== id;
        });
      });
    });
  });
</script>
